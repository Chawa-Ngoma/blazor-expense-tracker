@inject ExpenseTrackerState State

<EditForm Model="_model" OnValidSubmit="Submit" class="entity-form">
    <DataAnnotationsValidator />

    <div class="form-row">
        <label for="category-name">Name</label>
        <InputText id="category-name" @bind-Value="_model.Name" />
        <ValidationMessage For="() => _model.Name" />
    </div>

    <div class="form-row">
        <label for="category-color">Color</label>
        <div class="color-input">
            <input type="color" value="@_model.Color" @onchange="OnColorPickerChanged" />
            <InputText id="category-color" @bind-Value="_model.Color" placeholder="#3B82F6" />
        </div>
        <ValidationMessage For="() => _model.Color" />
    </div>

    @if (_errorMessage is not null)
    {
        <p class="form-error">@_errorMessage</p>
    }

    <div class="form-actions">
        <button type="submit" disabled="@_saving">@(Editing is null ? "Add category" : "Save changes")</button>
        <button type="button" @onclick="Cancel" disabled="@_saving">Cancel</button>
    </div>
</EditForm>

@code {
    /// <summary>Null to add a new category; set to edit an existing one.</summary>
    [Parameter] public CategoryDto? Editing { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private CategoryRequest _model = new() { Color = "#3B82F6" };
    private bool _saving;
    private string? _errorMessage;

    protected override void OnParametersSet()
    {
        _model = Editing is null
            ? new CategoryRequest { Color = "#3B82F6" }
            : new CategoryRequest { Name = Editing.Name, Color = Editing.Color };
    }

    private void OnColorPickerChanged(ChangeEventArgs e)
    {
        _model.Color = e.Value?.ToString() ?? _model.Color;
    }

    private async Task Submit()
    {
        _saving = true;
        _errorMessage = null;
        try
        {
            if (Editing is null)
                await State.CreateCategoryAsync(_model);
            else
                await State.UpdateCategoryAsync(Editing.Id, _model);

            await OnSaved.InvokeAsync();
        }
        catch (ApiException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task Cancel() => OnCancelled.InvokeAsync();
}
